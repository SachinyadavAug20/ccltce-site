# GitHub OAuth
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_REDIRECT_URI=http://localhost:3001/auth/callback

# Neon (Postgres serverless)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-name.region.aws.neon.tech/neondb?ssl=true

# Session signing (arbitrary secret, used by frontend cookie)
SESSION_SECRET=change_this_to_a_random_string

# App
PORT=3001