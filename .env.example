# ===== Supabase (used by browser via assets/js/supabase-config.js — mirror values there) =====
# Get these from: Supabase Dashboard > Project Settings > API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is server-only — never put it in frontend files
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
APP_URL=http://localhost:3000
PORT=3001

# ===== Legacy (old GitHub OAuth + Neon prototype — not used by Supabase path) =====
# GITHUB_CLIENT_ID=your_github_oauth_client_id
# GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
# GITHUB_REDIRECT_URI=http://localhost:3001/auth/callback
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-name.region.aws.neon.tech/neondb?ssl=true
# SESSION_SECRET=change_this_to_a_random_string
